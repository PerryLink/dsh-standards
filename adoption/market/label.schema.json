{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PerryLink/dsh-standards/adoption/market/label.schema.json",
  "title": "DSH market label",
  "description": "A read-only, immutable evidence label. The market renders it; it does not compute the level, rank, or certify.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "subject",
    "level",
    "status",
    "claimLevel",
    "scope",
    "validity",
    "evidence",
    "disclaimer",
    "verifyUrl",
    "issuer",
    "recordHash"
  ],
  "properties": {
    "schema": {
      "const": "dsh-market-label/1"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "version",
        "commit"
      ],
      "properties": {
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        }
      }
    },
    "level": {
      "enum": [
        "entry",
        "flow",
        "boost"
      ]
    },
    "status": {
      "enum": [
        "recognized",
        "static",
        "runtime",
        "blocked",
        "failed",
        "not-run",
        "stale",
        "manual",
        "measured",
        "not-measured",
        "withdrawn",
        "not-applicable"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dsh",
        "cordis"
      ],
      "properties": {
        "dsh": {
          "type": "string"
        },
        "cordis": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        }
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generatedAt",
        "expiresAt"
      ],
      "properties": {
        "generatedAt": {
          "type": "string",
          "format": "date"
        },
        "expiresAt": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "disclaimer": {
      "type": "string",
      "minLength": 12,
      "description": "Must contain the non-official / non-certification denial in the same view."
    },
    "verifyUrl": {
      "type": "string",
      "pattern": "^https://"
    },
    "withdrawn": {
      "type": "boolean"
    },
    "claimLevel": {
      "enum": [
        "observation",
        "reference",
        "advice"
      ]
    },
    "renderer": {
      "type": "string"
    },
    "recordHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "issuer": {
      "type": "string",
      "minLength": 1
    },
    "revokedAt": {
      "type": "string",
      "format": "date"
    },
    "supersedes": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "level": {
            "const": "entry"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "enum": [
              "recognized",
              "static",
              "runtime",
              "blocked",
              "failed",
              "not-run",
              "stale",
              "withdrawn",
              "not-applicable"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "level": {
            "const": "flow"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "enum": [
              "manual",
              "runtime",
              "failed",
              "not-run",
              "stale",
              "withdrawn",
              "not-applicable"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "level": {
            "const": "boost"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "enum": [
              "measured",
              "not-measured",
              "failed",
              "stale",
              "withdrawn",
              "not-applicable"
            ]
          }
        }
      }
    }
  ]
}
