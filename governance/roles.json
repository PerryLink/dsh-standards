  "decisions": {
    "A": {
      "label": "不可逆/对外/法律",
      "examples": [
        "level definition and name",
        "attestation issue or revoke",
        "mark policy",
        "legal statement or external position",
        "role appointment"
      ],
      "approver": [
        "organizer"
      ],
      "aiAllowed": false,
      "reviewers": [],
      "commentDays": 0,
      "provisionalDays": 90,
      "record": "governance/decision-log.md"
    },
    "B": {
      "label": "标准语义/认证方案",
      "examples": [
        "spec text and clause change",
        "gate semantics",
        "certification scheme",
        "new level status or deprecation"
      ],
      "approver": [
        "organizer"
      ],
      "aiAllowed": true,
      "aiRole": "draft-only",
      "reviewers": [
        "maintainer",
        "reviewer"
      ],
      "commentDays": 7,
      "provisionalDays": 90,
      "record": "governance/decision-log.md"
    },
    "C": {
      "label": "代码/模式/展示",
      "examples": [
        "checker code",
        "schemas",
        "portal and catalog display",
        "CI workflows"
      ],
      "approver": [
        "maintainer"
      ],
      "aiAllowed": true,
      "aiRole": "implement-and-propose",
      "reviewers": [
        "maintainer"
      ],
      "commentDays": 0,
      "provisionalDays": 30,
      "record": "governance/decision-log.md"
    },
    "D": {
      "label": "例行/可逆",
      "examples": [
        "triage and labels",
        "link and description fixes",
        "read-only registry sync",
        "report generation",
        "translation of non-normative text"
      ],
      "approver": [
        "ai-steward",
        "ai-registrar",
        "ai-monitor",
        "ai-translator"
      ],
      "aiAllowed": true,
      "reviewers": [],
      "commentDays": 0,
      "provisionalDays": 0,
      "record": "governance/ai-actions.log"
    }
  },
  "quorum": {
    "solo": {
      "humanMaintainers": 1,
      "classA": "organizer",
      "classB": "organizer after 7-day public comment; provisional for 90 days",
      "classC": "organizer",
      "classD": "AI role; logged; reversible",
      "claim": "provisional; never 'consensus'"
    },
    "team": {
      "humanMaintainers": 2,
      "classA": "organizer + 1 maintainer",
      "classB": "2 of 3 reviewers (organizer counts as one)",
      "classC": "1 maintainer",
      "classD": "AI role; logged; reversible",
      "claim": "reviewed; not official"
    },
    "council": {
      "humanMaintainers": 5,
      "organizations": 3,
      "classA": "organizer + 2 maintainers from different organizations",
      "classB": "2/3 of appointed reviewers",
      "classC": "1 maintainer",
      "classD": "AI role; logged; reversible",
      "claim": "community-reviewed; still not official"
    }
  },
  "coi": {
    "requiredFields": [
      "employer",
      "funding",
      "ownPlugins",
      "marketRoles"
    ],
    "selfAssessedFlag": "required when the organizer or a maintainer is the plugin author",
    "recusal": [
      "same GitHub organization as the subject author",
      "same employer or funder as the subject author",
      "paid by the subject author in the last 12 months",
      "author of the subject plugin"
    ],
    "record": "governance/coi.json"
  },
  "ai": {
    "trailers": [
      "AI-Agent",
      "AI-Model",
      "AI-Assisted"
    ],
    "forbiddenPermissions": [
      "spec.decide",
      "attestation.issue",
      "attestation.revoke",
      "mark.policy",
      "external.speak",
      "roles.assign",
      "finance.manage",
      "appeal.decide",
      "release.approve"
    ],
    "mergeAllowlist": [
      "docs/",
      "results/",
      "data/",
      "publish/",
      "adoption/",
      "*.md"
    ],
    "mergeDenylist": [
      "spec/",
      "governance/",
      "40-checker/",
      "GOVERNANCE.md",
      "CONTRIBUTING.md",
      "MAINTAINERS.md",
      "SECURITY.md"
    ],
    "mustNot": [
      "approve its own pull request",
      "sign DCO for a human",
      "change an evidence PASS/FAIL value",
      "delete a dispute or audit record",
      "use a secret outside its scoped token"
    ],
    "auditLog": "governance/ai-actions.log"
  },
  "activatedAt": "2026-11-01",
  "activationDecision": "D-014"
}
