{
  "schema": "dsh-governance/1",
  "version": "1.0.0-rc.1",
  "updatedAt": "2026-11-01",
  "status": "active",
  "nonOfficial": true,
  "stage": "solo",
  "creator": "PerryLink",
  "disclaimer": "Non-official role model for a community draft. It is not a legal entity, not an accreditation, and not a labour or agency relationship. AI roles are software actors, not persons.",
  "roles": {
    "organizer": {
      "label": "创建者/组织者",
      "humanOnly": true,
      "bot": false,
      "maxHolders": 1,
      "appointment": "creator",
      "termDays": null,
      "dormantAfterDays": null,
      "owns": [
        "name and scope of the three levels",
        "final signature on standard text and attestation issuance",
        "external statements and legal counterparty role",
        "appointment and removal of maintainers"
      ],
      "cannot": [
        "review own plugin as an independent reviewer",
        "claim official, accredited, or CNAS status",
        "issue an attestation without a public evidence record"
      ]
    },
    "maintainer": {
      "label": "管理者",
      "humanOnly": true,
      "bot": false,
      "maxHolders": 5,
      "appointment": "organizer",
      "termDays": 180,
      "dormantAfterDays": 90,
      "owns": [
        "merge and release in an assigned area",
        "reviewer appointment proposals",
        "registry and portal data changes",
        "draft attestations for organizer signature"
      ],
      "cannot": [
        "issue or revoke an attestation alone",
        "change the meaning of a level alone",
        "merge their own plugin's certification record",
        "speak for the project on legal or official matters"
      ]
    },
    "reviewer": {
      "label": "评审员",
      "humanOnly": true,
      "bot": false,
      "maxHolders": 20,
      "appointment": "maintainer proposes, organizer confirms",
      "termDays": 180,
      "dormantAfterDays": 90,
      "owns": [
        "review records with clause IDs and evidence",
        "shadow reviews and known-answer exercises",
        "conflict-of-interest declarations"
      ],
      "cannot": [
        "merge to the default branch",
        "issue an attestation",
        "review a subject with an undisclosed conflict"
      ]
    },
    "contributor": {
      "label": "贡献者",
      "humanOnly": false,
      "bot": false,
      "maxHolders": null,
      "appointment": "self-serve after DCO and terms attestation",
      "termDays": null,
      "dormantAfterDays": 365,
      "owns": [
        "their contribution and its licensing attestation",
        "disclosure of AI assistance and employer ownership"
      ],
      "cannot": [
        "merge to the default branch",
        "approve their own change",
        "speak for the project"
      ]
    },
    "user": {
      "label": "使用者",
      "humanOnly": false,
      "bot": false,
      "maxHolders": null,
      "appointment": "self-serve",
      "termDays": null,
      "dormantAfterDays": null,
      "owns": [
        "their installation and configuration choices",
        "reporting reproducible problems"
      ],
      "cannot": [
        "claim that a label is a warranty or a security audit"
      ]
    },
    "ai-steward": {
      "label": "AI 管家",
      "humanOnly": false,
      "bot": true,
      "maxHolders": null,
      "appointment": "organizer configures the bot account",
      "termDays": null,
      "dormantAfterDays": null,
      "owns": [
        "triage, labels, summaries, issue routing",
        "draft pull requests and documentation updates",
        "merge only inside the AI merge allowlist after CI"
      ],
      "cannot": [
        "merge spec, governance, checker, or attestation files",
        "approve its own pull request",
        "sign the DCO on behalf of a human"
      ]
    },
    "ai-inspector": {
      "label": "AI 检验员",
      "humanOnly": false,
      "bot": true,
      "maxHolders": null,
      "appointment": "organizer configures the bot account",
      "termDays": null,
      "dormantAfterDays": null,
      "owns": [
        "running checks and producing evidence records",
        "reproducing reported failures",
        "writing method versions and limitations"
      ],
      "cannot": [
        "write PASS without a command output",
        "issue or revoke an attestation",
        "change a gate definition"
      ]
    },
    "ai-registrar": {
      "label": "AI 登记员",
      "humanOnly": false,
      "bot": true,
      "maxHolders": null,
      "appointment": "organizer configures the bot account",
      "termDays": null,
      "dormantAfterDays": null,
      "owns": [
        "validating registry and attestation JSON",
        "syncing read-only mirrors",
        "detecting expired or inconsistent records"
      ],
      "cannot": [
        "issue, suspend, or revoke an attestation",
        "invent an attestation ID",
        "edit evidence values"
      ]
    },
    "ai-clerk": {
      "label": "AI 书记员",
      "humanOnly": false,
      "bot": true,
      "maxHolders": null,
      "appointment": "organizer configures the bot account",
      "termDays": null,
      "dormantAfterDays": null,
      "owns": [
        "DCO and contribution-terms intake",
        "appeal intake, deadline tracking, recusal checks",
        "decision-log and action-log append"
      ],
      "cannot": [
        "decide an appeal",
        "delete a dispute record",
        "grant a role"
      ]
    },
    "ai-monitor": {
      "label": "AI 监督员",
      "humanOnly": false,
      "bot": true,
      "maxHolders": null,
      "appointment": "organizer configures the bot account",
      "termDays": null,
      "dormantAfterDays": null,
      "owns": [
        "quarterly link, version, and evidence-expiry checks",
        "stale and withdrawn status reports",
        "public surveillance reports"
      ],
      "cannot": [
        "punish, delist, or revoke",
        "change a status without a human decision"
      ]
    },
    "ai-translator": {
      "label": "AI 翻译",
      "humanOnly": false,
      "bot": true,
      "maxHolders": null,
      "appointment": "organizer configures the bot account",
      "termDays": null,
      "dormantAfterDays": null,
      "owns": [
        "translating documentation and keeping a glossary",
        "flagging untranslatable normative terms"
      ],
      "cannot": [
        "change normative meaning",
        "translate a clause without a source link"
      ]
    }
  },
