{
  "name": "dsh-standards",
  "version": "1.7.0",
  "description": "DSH plugin standards and conformance checks: ENTRY/FLOW checks plus BOOST guidance. Non-official; no certification or ranking.",
  "type": "module",
  "main": "40-checker/src/index.mjs",
  "exports": {
    ".": "./40-checker/src/index.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-standards": "./bin/dsh-standards.mjs",
    "dsh-levels": "./bin/dsh-levels.mjs"
  },
  "files": [
    "bin",
    "40-checker/bin",
    "40-checker/src",
    "40-checker/vendor",
    "40-checker/scripts",
    "40-checker/samples",
    "40-checker/fixtures",
    "40-checker/package.json",
    "40-checker/README.md",
    "spec",
    "examples/compatum",
    "docs",
    "README.md",
    "SECURITY.md",
    "31-*.md",
    "34-*.md",
    "CHANGELOG.md",
    "LICENSE",
    "LICENSE-APACHE",
    "LICENSE-CC-BY",
    "NOTICE.md",
    "NOTICE"
  ],
  "scripts": {
    "test": "node 40-checker/scripts/run-tests.mjs",
    "test:compatum": "node spec/compatum-validate.mjs",
    "test:fixtures": "node bin/dsh-standards.mjs 40-checker/fixtures/good --scope entry --entry-claim static --format text",
    "verify:repo-anchors": "node 40-checker/scripts/repo-anchor-check.mjs"
  },
  "engines": {
    "node": ">=24.9.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "standards",
    "checker",
    "conformance",
    "entry",
    "flow",
    "boost"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerryLink/dsh-standards.git"
  },
  "homepage": "https://github.com/PerryLink/dsh-standards#readme",
  "bugs": {
    "url": "https://github.com/PerryLink/dsh-standards/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
