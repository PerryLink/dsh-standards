{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PerryLink/dsh-standards/spec/flow-evidence.schema.json",
  "title": "DSH FLOW evidence chain",
  "description": "One collected FLOW result (J1-J8) bound to a package, a host, a timestamp, and a chain hash. Structural validation only: it does not prove the commands really ran. v1 (dsh-flow-journey/1, dsh-flow-runtime/1) and bare {Jx:{status}} documents are deprecated and never count as a pass. `level-audit.mjs --flow-evidence` accepts this document only, and reports `runtime` only when `claims.claimLevel` is `sandbox-attested` or `producer.kind` is `sandbox`; `sandbox-degraded` (any isolation item missing) and self-attested/ci-attested keep their pass count but stay not-run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generatedAt",
    "producer",
    "subject",
    "host",
    "journeys",
    "claims",
    "chain"
  ],
  "properties": {
    "schema": {
      "const": "dsh-flow-evidence/2"
    },
    "evidenceId": {
      "type": "string",
      "minLength": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "object",
      "description": "Who collected the evidence. `kind: sandbox` is the producer-side equivalent of `claims.claimLevel: sandbox-attested` and is one of the two ways a document may be reported as FLOW runtime.",
      "additionalProperties": false,
      "required": ["command", "at"],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "kind": {
          "enum": ["local", "ci", "sandbox", "sandbox-degraded"],
          "description": "`local`/`ci` are structural evidence only; `sandbox` (every isolation item effective) may count toward FLOW runtime; `sandbox-degraded` never does."
        },
        "runner": { "type": "string" },
        "actor": { "type": "string" },
        "runUrl": { "type": "string" }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "integrity", "tarballSha256", "commit", "treeSha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "integrity": {
          "oneOf": [
            { "type": "string", "pattern": "^(sha512|sha256)-[A-Za-z0-9+/=]+$" },
            { "type": "null" }
          ]
        },
        "tarballSha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "commit": {
          "oneOf": [
            { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            { "type": "null" }
          ]
        },
        "treeSha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "treeSha256After": {
          "oneOf": [
            { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            { "type": "null" }
          ]
        },
        "treeStable": { "type": "boolean" },
        "treeExclude": {
          "type": "array",
          "items": { "type": "string" }
        },
        "source": { "type": "string" }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dsh", "node", "platform"],
      "properties": {
        "dsh": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "dshCommit": {
          "oneOf": [
            { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
            { "type": "null" }
          ]
        },
        "cordis": { "type": "string" },
        "node": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 }
      }
    },
    "sandbox": {
      "type": "object",
      "description": "Containment report from `flow collect --sandbox`. `mode` is `sandbox` only when every isolation item (env allowlist + token assertion, temporary HOME/DSH_HOME, network namespace, prlimit nproc/as, process-group tree kill) is effective. `producer.kind=sandbox` requires mode=sandbox and an empty `degraded` list.",
      "required": ["mode", "degraded"],
      "properties": {
        "schema": { "const": "dsh-sandbox-report/1" },
        "mode": { "enum": ["sandbox", "sandbox-degraded"] },
        "degraded": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Missing isolation items, e.g. unshare-missing, prlimit-missing, env-token-present, home-not-isolated."
        },
        "platform": { "type": "string" },
        "env": {
          "type": "object",
          "properties": {
            "policy": { "type": "string" },
            "checked": { "type": "array", "items": { "type": "string" } },
            "absent": { "type": "boolean" },
            "offenders": { "type": "array", "items": { "type": "string" } }
          }
        },
        "home": {
          "type": "object",
          "properties": {
            "isolated": { "type": "boolean" },
            "mode": { "type": "string" }
          }
        },
        "network": {
          "type": "object",
          "properties": {
            "isolated": { "type": "boolean" },
            "mechanism": { "type": "string" },
            "reason": { "type": "string" },
            "bin": { "type": "string" },
            "args": { "type": "array", "items": { "type": "string" } },
            "probe": { "type": "object" },
            "attempts": { "type": "array", "items": { "type": "object" } }
          }
        },
        "limits": {
          "type": "object",
          "properties": {
            "available": { "type": "boolean" },
            "bin": { "type": "string" },
            "nproc": { "type": "integer", "minimum": 2 },
            "asBytes": { "type": "integer", "minimum": 67108864 },
            "applied": { "type": "array", "items": { "type": "string" } },
            "observed": { "type": "object" },
            "probe": { "type": "object" },
            "reason": { "type": "string" }
          }
        },
        "processTreeKill": {
          "type": "object",
          "properties": {
            "available": { "type": "boolean" },
            "mechanism": { "type": "string" }
          }
        },
        "executed": { "type": "boolean", "description": "True when the sandboxed runtime probe actually ran." },
        "execution": { "type": "object", "description": "Command, exit code, timeout/kill outcome, and process-tree clearing proof." },
        "note": { "type": "string" }
      }
    },
    "journeys": {
      "type": "object",
      "additionalProperties": false,
      "required": ["J1", "J2", "J3", "J4", "J5", "J6", "J7", "J8"],
      "patternProperties": {
        "^J[1-8]$": { "$ref": "#/$defs/journey" }
      }
    },
    "claims": {
      "type": "object",
      "description": "Attestation level of this evidence. Passing journeys are not runtime by themselves: `level-audit` may report `runtime` only when `claimLevel` is `sandbox-attested` (or `producer.kind` is `sandbox`). `self-attested` (local collector), `ci-attested` (`--ci`), and every `sandbox-degraded` document keep their `passed` count but are reported `not-run`, because structural validation cannot prove the commands ran, let alone in a fully isolated sandbox.",
      "additionalProperties": false,
      "required": ["claimLevel"],
      "properties": {
        "claimLevel": {
          "enum": ["self-attested", "ci-attested", "sandbox-attested"],
          "description": "`sandbox-attested` is the only claim level that can yield FLOW runtime; `self-attested` and `ci-attested` are never runtime."
        },
        "notClaimed": {
          "type": "array",
          "items": { "type": "string" }
        },
        "method": { "type": "string" }
      }
    },
    "chain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceHash"],
      "properties": {
        "evidenceHash": { "$ref": "#/$defs/sha256" }
      }
    },
    "conclusion": {
      "enum": ["flow-pass", "flow-warn", "flow-blocked", "flow-fail"]
    },
    "signature": {
      "oneOf": [{ "type": "object" }, { "type": "null" }]
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "log": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "observed"],
      "properties": {
        "claim": { "type": "string", "minLength": 1 },
        "observed": { "type": "boolean" },
        "detail": { "type": "string" }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command", "exitCode", "startedAt", "endedAt", "stdout", "assertions"],
      "properties": {
        "id": { "type": "string", "pattern": "^J[1-8](?:\\.[A-Za-z0-9._-]+)?$" },
        "kind": { "enum": ["observed", "static", "manual"] },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "exitCode": { "type": "integer", "minimum": 0, "maximum": 255 },
        "startedAt": { "type": "string", "format": "date-time" },
        "endedAt": { "type": "string", "format": "date-time" },
        "stdout": { "$ref": "#/$defs/log" },
        "stderr": { "$ref": "#/$defs/log" },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/assertion" }
        },
        "durationMs": { "type": "number", "minimum": 0 }
      }
    },
    "journey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checks"],
      "properties": {
        "status": {
          "enum": ["pass", "fail", "warn", "blocked", "static", "na", "not-run"]
        },
        "reason": { "type": "string" },
        "kind": { "type": "string" },
        "limitations": {
          "type": "array",
          "items": { "type": "string" }
        },
        "checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/check" }
        }
      }
    }
  }
}
