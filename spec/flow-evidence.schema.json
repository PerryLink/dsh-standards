{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PerryLink/dsh-standards/spec/flow-evidence.schema.json",
  "title": "DSH FLOW evidence chain",
  "description": "One collected FLOW result (J1-J8) bound to a package, a host, a timestamp, and a chain hash. Structural validation only: it does not prove the commands really ran. v1 (dsh-flow-journey/1, dsh-flow-runtime/1) and bare {Jx:{status}} documents are deprecated and never count as a pass. `level-audit.mjs --flow-evidence` accepts this document only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generatedAt",
    "producer",
    "subject",
    "host",
    "journeys",
    "claims",
    "chain"
  ],
  "properties": {
    "schema": {
      "const": "dsh-flow-evidence/2"
    },
    "evidenceId": {
      "type": "string",
      "minLength": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "at"],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "kind": {
          "enum": ["local", "ci", "sandbox"]
        },
        "runner": { "type": "string" },
        "actor": { "type": "string" },
        "runUrl": { "type": "string" }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "integrity", "tarballSha256", "commit", "treeSha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "integrity": {
          "oneOf": [
            { "type": "string", "pattern": "^(sha512|sha256)-[A-Za-z0-9+/=]+$" },
            { "type": "null" }
          ]
        },
        "tarballSha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "commit": {
          "oneOf": [
            { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            { "type": "null" }
          ]
        },
        "treeSha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "treeSha256After": {
          "oneOf": [
            { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            { "type": "null" }
          ]
        },
        "treeStable": { "type": "boolean" },
        "treeExclude": {
          "type": "array",
          "items": { "type": "string" }
        },
        "source": { "type": "string" }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dsh", "node", "platform"],
      "properties": {
        "dsh": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "dshCommit": {
          "oneOf": [
            { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
            { "type": "null" }
          ]
        },
        "cordis": { "type": "string" },
        "node": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 }
      }
    },
    "journeys": {
      "type": "object",
      "additionalProperties": false,
      "required": ["J1", "J2", "J3", "J4", "J5", "J6", "J7", "J8"],
      "patternProperties": {
        "^J[1-8]$": { "$ref": "#/$defs/journey" }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claimLevel"],
      "properties": {
        "claimLevel": {
          "enum": ["self-attested", "ci-attested", "sandbox-attested"]
        },
        "notClaimed": {
          "type": "array",
          "items": { "type": "string" }
        },
        "method": { "type": "string" }
      }
    },
    "chain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceHash"],
      "properties": {
        "evidenceHash": { "$ref": "#/$defs/sha256" }
      }
    },
    "conclusion": {
      "enum": ["flow-pass", "flow-warn", "flow-blocked", "flow-fail"]
    },
    "signature": {
      "oneOf": [{ "type": "object" }, { "type": "null" }]
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "log": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "observed"],
      "properties": {
        "claim": { "type": "string", "minLength": 1 },
        "observed": { "type": "boolean" },
        "detail": { "type": "string" }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command", "exitCode", "startedAt", "endedAt", "stdout", "assertions"],
      "properties": {
        "id": { "type": "string", "pattern": "^J[1-8](?:\\.[A-Za-z0-9._-]+)?$" },
        "kind": { "enum": ["observed", "static", "manual"] },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "exitCode": { "type": "integer", "minimum": 0, "maximum": 255 },
        "startedAt": { "type": "string", "format": "date-time" },
        "endedAt": { "type": "string", "format": "date-time" },
        "stdout": { "$ref": "#/$defs/log" },
        "stderr": { "$ref": "#/$defs/log" },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/assertion" }
        },
        "durationMs": { "type": "number", "minimum": 0 }
      }
    },
    "journey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checks"],
      "properties": {
        "status": {
          "enum": ["pass", "fail", "warn", "blocked", "static", "na", "not-run"]
        },
        "reason": { "type": "string" },
        "kind": { "type": "string" },
        "limitations": {
          "type": "array",
          "items": { "type": "string" }
        },
        "checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/check" }
        }
      }
    }
  }
}
