{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PerryLink/dsh-standards/spec/schemas/report.schema.json",
  "title": "DSH test report",
  "description": "A test report (inspection) is not an attestation. It has no grade and no level. Attestation is a separate document that may cite a report ID.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "reportId", "subject", "method", "environment", "checks", "limitations", "issuedAt"],
  "not": { "anyOf": [{ "required": ["grade"] }, { "required": ["level"] }] },
  "properties": {
    "schema": { "const": "dsh-report/1" },
    "reportId": { "type": "string", "pattern": "^DSH-RPT-[0-9]{4}-[0-9]{3}$" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo"],
      "properties": {
        "repo": { "type": "string" },
        "version": { "type": "string" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "version"],
      "properties": {
        "tool": { "type": "string" },
        "version": { "type": "string" },
        "command": { "type": "string" },
        "sample": { "type": "string" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "node"],
      "properties": {
        "os": { "type": "string" },
        "node": { "type": "string" },
        "dsh": { "type": "string" },
        "cordis": { "type": "string" }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "result"],
        "properties": {
          "id": { "type": "string" },
          "result": { "enum": ["PASS", "FAIL", "WARN", "NOT-RUN", "BLOCKED", "ERROR"] },
          "reason": { "type": "string" },
          "artifact": { "type": "string" }
        }
      }
    },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "issuedAt": { "type": "string", "format": "date" },
    "issuedBy": { "type": "string" }
  }
}
